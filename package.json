{
  "name": "credchain-interim-demo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "CredChain: A Decentralized Academic Credential Verification System",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "chain": "hardhat node --network local --hostname 127.0.0.1",
    "compile": "node scripts/compile.mjs",
    "deploy": "node scripts/deploy.mjs",
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:chain": "node --test test/chain.integration.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": { "ethers": "6.17.0", "solc": "0.8.30" },
  "devDependencies": { "hardhat": "^3.0.0" }
}
